# ============================================================
# Frontend — copy to .env.local for local dev, or set each var
# in the Vercel dashboard (Project Settings → Environment
# Variables) for production. Redeploy after changing them.
# ============================================================

# ----- LOCAL DEV ONLY -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# ----- PRODUCTION (Vercel) -----
# On Vercel, set NEXT_PUBLIC_API_BASE_URL = /api
# This tells the browser to call Vercel's same-origin /api/*,
# which next.config.mjs rewrites/proxies to your Render backend
# BEHIND THE SCENES — completely avoiding CORS errors.
#
# NEXT_PUBLIC_API_BASE_URL=/api

# ----- BOTH (OPTIONAL — needed only if middleware can't reach backend) -----
# The fully-qualified Render backend URL, used server-side by
# middleware.ts (admin route gate) and by next.config.mjs rewrites
# as the destination of the /api proxy.
# Example: https://lexliberia-backend-styd.onrender.com/api
#
# NEXT_PUBLIC_REMOTE_API_BASE_URL=https://lexliberia-backend-styd.onrender.com/api

# ----- Google OAuth -----
# Same OAuth client ID you configure in Google Cloud Console AND
# on the Render backend (GOOGLE_CLIENT_ID). Leave blank locally.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ============================================================
# On the RENDER BACKEND side, set CLIENT_URL to include BOTH:
#   CLIENT_URL=http://localhost:3000,https://your-vercel-app.vercel.app
# (comma-separated, no trailing slashes)
# Even with the Vercel proxy, your Render CORS allow-list should
# include your Vercel domain just in case.
# ============================================================
